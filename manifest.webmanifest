{
  "id": "./",
  "name": "Teleprompter — guion y cámara",
  "short_name": "Teleprompter",
  "description": "Lee tu guion sobre la cámara y graba vídeo con audio. El texto del teleprompter nunca aparece en la grabación.",
  "lang": "es",
